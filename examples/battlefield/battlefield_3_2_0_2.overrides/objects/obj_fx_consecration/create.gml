// Consecrated ground (gm-revive overrides): one steady patch for the whole of a Paladin's Consecration,
// a golden sigil turning slowly over a soft glow, fading in and out at the ends. The half-second damage
// ticks add a ring (paladin_consecration_pulse). Drawn under the units.
_r = 72;
_life = room_speed * 8;
_t = 0;
image_angle = random(360);
image_speed = 0;
