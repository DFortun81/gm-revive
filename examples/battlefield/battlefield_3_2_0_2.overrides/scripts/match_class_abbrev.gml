switch(argument0) {
    case class_warrior: return "War";
    case class_caster: return "Cas";
    case class_healer: return "Hea";
    case class_shaman: return "Sha";
    case class_rogue: return "Rog";
    case class_druid: return "Dru";
    case class_paladin: return "Pal";
}
return "?";
